.env
.env.local
.env.*.local

# SSH keys, kubeconfig and known_hosts for the Control API.
# These grant power-off access to the fleet — never commit them.
#
# Note: this must be `secrets/*`, not `secrets/`. Git does not descend into an
# ignored directory, so with `secrets/` the negation below would never apply
# and the placeholder would be dropped.
secrets/*
!secrets/.gitkeep
