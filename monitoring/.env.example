# monitoring/.env.example
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# ── Grafana ─────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
# Generate one: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# ── Control API ─────────────────────────────────────────────────────
# Bearer token protecting the wake/shutdown endpoints. Anyone holding this
# can power your nodes on and off — treat it like a password.
#   openssl rand -hex 32
CONTROL_API_TOKEN=

# How Grafana reaches the Control API. control-api runs with host networking
# on Ocra, so this is Ocra's own address on the tailnet.
CONTROL_API_URL=http://ocra.stegosaurus-panga.ts.net:8090

# ── Control API credentials (paths on the Ocra host) ────────────────
# Dedicated SSH key allowed to run `sudo shutdown -h now` on the nodes.
# Create with:  ssh-keygen -t ed25519 -f ./secrets/control_id_ed25519 -N ''
# Then append the .pub to ~/.ssh/authorized_keys on sram, xelor and sacro.
CONTROL_API_SSH_KEY=./secrets/control_id_ed25519

# Pre-seeded known_hosts so the container does not prompt on first connect:
#   ssh-keyscan sram xelor sacro > ./secrets/known_hosts
CONTROL_API_KNOWN_HOSTS=./secrets/known_hosts

# kubeconfig used to drain nodes from k3s before powering them off.
# Copy from Sadida: scp sadida:/etc/rancher/k3s/k3s.yaml ./secrets/kubeconfig
# then edit the server: field to point at Sadida's tailnet address.
CONTROL_API_KUBECONFIG=./secrets/kubeconfig

# ── Idle auto-shutdown ────────────────────────────────────────────────
# Watches per-node network traffic and calls the Control API to shut down a
# node once it has been idle past its timeout. SAFE BY DEFAULT: dry-run
# (log only) until you explicitly set IDLE_SHUTDOWN_DRY_RUN=false, and it
# only ever considers nodes listed in IDLE_SHUTDOWN_NODES.
#
# Comma-separated, e.g.: aery,sram,xelor
# Leave empty to disable entirely (the daemon still runs, manages nothing).
IDLE_SHUTDOWN_NODES=

# Set to "false" only after watching a few days of dry-run logs
# (docker compose logs -f idle-shutdown) and confirming the decisions look
# right for YOUR usage patterns.
IDLE_SHUTDOWN_DRY_RUN=true

# How often the daemon evaluates all managed nodes.
IDLE_CHECK_INTERVAL_SECONDS=300

# Idle window in minutes, per node (unset = use the default below).
IDLE_TIMEOUT_MINUTES_DEFAULT=60
IDLE_TIMEOUT_MINUTES_AERY=120
IDLE_TIMEOUT_MINUTES_SRAM=60
IDLE_TIMEOUT_MINUTES_XELOR=30

# Combined rx+tx bytes/sec below which a node counts as idle. ~50 KB/s
# clears normal Prometheus scrape chatter; tune if you see false positives
# (shuts down while still "in use" by something bursty) or false negatives
# (never triggers because baseline traffic sits above this).
IDLE_TRAFFIC_THRESHOLD_BPS=51200

# REQUIRED for Aery specifically: shutdown is blocked for Aery by default
# (see control-api/server.js) because it hosts Nextcloud + shared storage.
# Do NOT set this to true until you have verified Wake-on-LAN actually wakes
# Aery back up from a full power-off — see monitoring/README.md.
CONTROL_API_ALLOW_SHUTDOWN_AERY=false

# ── Shelly power meter (Phase 3 — real measured wattage) ────────────
# Gen2/Plus smart plug wired into the wall outlet feeding the shared power
# strip/UPS all the compute nodes are plugged into. Give it a static LAN IP
# or a DHCP reservation — this URL must not change under the exporter.
#   http://<shelly-ip>/                        (no auth configured)
#   http://admin:<password>@<shelly-ip>/       (if RPC auth is enabled)
SHELLY_PSU_URL=
