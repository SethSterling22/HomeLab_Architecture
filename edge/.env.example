# edge/.env.example
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# Email Let's Encrypt uses for certificate expiry/problem notifications.
# Not shown publicly anywhere.
ACME_EMAIL=

# Your No-IP hostname, e.g. yourname.ddns.net. Must exactly match the
# hostname line in ddclient/ddclient.conf (see ddclient.conf.example).
NOIP_HOSTNAME=
